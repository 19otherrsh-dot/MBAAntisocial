# Copy to .env.local and fill in. `src/lib/env.ts` validates these at boot and
# fails with a readable message rather than surfacing undefined mid-request.

# ── Required ─────────────────────────────────────────────────────────────────

# MongoDB connection string. Local Docker:
#   docker run -d -p 27017:27017 --name mba-mongo mongo:7
MONGODB_URI=mongodb://127.0.0.1:27017/mba-antisocial

# Session signing secret, 32+ characters. Generate one with:
#   npx auth secret
# Never reuse the development value in production.
AUTH_SECRET=replace-me-with-at-least-thirty-two-characters

# ── Optional ─────────────────────────────────────────────────────────────────

# Database name, when it is not already in the URI.
# MONGODB_DB_NAME=mba-antisocial

# Public origin. Used for absolute URLs.
APP_URL=http://localhost:3000

# Comma-separated email domains permitted to register. Empty means open
# registration. Pin this for a campus rollout so a batch stays a batch:
#   ALLOWED_EMAIL_DOMAINS=iima.ac.in,iimb.ac.in
ALLOWED_EMAIL_DOMAINS=

# Binds an email domain to the campus it proves, as domain=Campus pairs. Once a
# campus is listed, only its own addresses can register into it, and the
# address decides the campus. Campus names must match src/lib/constants.ts.
#   CAMPUS_EMAIL_DOMAINS=iima.ac.in=IIM Ahmedabad,iimb.ac.in=IIM Bangalore
CAMPUS_EMAIL_DOMAINS=

# The zone days, streaks, deadlines and notification times roll over in.
# Hosts usually run in UTC, which is never what a campus means by "today".
APP_TIME_ZONE=Asia/Kolkata

# ── Integrations ─────────────────────────────────────────────────────────────
# Not validated by `src/lib/env.ts`; each feature below needs its own keys.

# Google Gemini, read implicitly by `@ai-sdk/google` for the AI interview and
# roast routes (src/app/api/ai/*). Without it those pages explain that AI is
# not switched on, rather than failing.
GOOGLE_GENERATIVE_AI_API_KEY=
# Which Gemini model to call. Pin a specific stable id in production; an alias
# can move under you.
GEMINI_MODEL=gemini-flash-latest

# Cloudinary, for uploads. CLOUDINARY_CLOUD_NAME also pins which URLs the
# server will fetch (see isOwnCloudinaryUrl in src/lib/cloudinary.ts).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Pusher, for realtime messages and notifications. Optional: without it, new
# items appear on the next load. Every channel is private and authorised by
# /api/pusher/auth. The NEXT_PUBLIC_ pair is shipped to the browser.
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Resend, for email: address confirmation, password reset, and the weekly
# digest. Without it, links are printed to the server log in development.
RESEND_API_KEY=
EMAIL_FROM=MBAAntisocial <noreply@your-domain.com>
# Require new accounts to confirm their address before signing in. Defaults to
# on when RESEND_API_KEY is set, off otherwise.
# REQUIRE_EMAIL_VERIFICATION=true

# Bearer token the Vercel cron (vercel.json) sends to /api/cron/digest.
CRON_SECRET=
