{
  "name": "mba-antisocial",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "test": "node --import tsx --import ./tests/setup-env.ts --test \"tests/**/*.test.ts\"",
    "db:indexes": "tsx scripts/sync-indexes.ts",
    "db:migrate": "migrate-mongo up -f migrate-mongo-config.cjs",
    "db:migrate:status": "migrate-mongo status -f migrate-mongo-config.cjs",
    "db:migrate:create": "migrate-mongo create -f migrate-mongo-config.cjs",
    "test:e2e": "playwright test",
    "load-test": "tsx scripts/load-test.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.44",
    "@ai-sdk/react": "^4.0.69",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sentry/nextjs": "11.11.0",
    "ai": "^7.0.66",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "lucide-react": "^1.31.0",
    "mongoose": "^9.9.2",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "pdf-parse": "^2.4.5",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/autocannon": "^7.12.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autocannon": "^8.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "migrate-mongo": "14.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
