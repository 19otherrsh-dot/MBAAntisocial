{
  "name": "mba-antisocial",
  "version": "1.0.0",
  "private": true,
  "description": "MBAAntisocial monorepo: web app + API, realtime server, native app, shared packages, and the Godot game SDK.",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/web",
    "apps/realtime",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @mba/web",
    "dev:realtime": "npm run dev --workspace @mba/realtime",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "seed": "npm run seed --workspace @mba/web",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  }
}
