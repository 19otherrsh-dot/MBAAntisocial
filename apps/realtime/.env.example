# ─────────────────────────────────────────────────────────────────────────────
# MBAAntisocial realtime service (apps/realtime). Copy to .env.
# The secrets must match the web app's.
# ─────────────────────────────────────────────────────────────────────────────

PORT=4000
HOST=0.0.0.0

# Same values as apps/web.
AUTH_SECRET=
REALTIME_SECRET=
INTERNAL_API_SECRET=
REDIS_URL=redis://127.0.0.1:6379

# How this service reaches the web app (http://web:3000 inside docker compose).
WEB_INTERNAL_URL=http://localhost:3000
# The public web origin, allowed to open sockets. Add more, comma-separated, in CORS_ORIGINS.
APP_URL=http://localhost:3000
CORS_ORIGINS=

# Runs /api/cron/* on schedule. Turn on for Docker and VPS deployments, and off
# on Vercel, where vercel.json crons do the same job.
SCHEDULER_ENABLED=false
CRON_SECRET=

# Dedicated Godot servers (optional). Point GODOT_BIN at a Godot 4 binary;
# server packs from `publish-game --server-pack` live in GAME_SERVERS_DIR.
GODOT_BIN=
GAME_SERVERS_DIR=../../game-servers
GAME_SERVER_PORT_MIN=20000
GAME_SERVER_PORT_MAX=20200
GAME_SERVER_MAX_PROCESSES=20
GAME_SERVER_IDLE_SECONDS=120

# Discord bridge: inbound messages arrive over the bot's gateway connection.
DISCORD_BOT_TOKEN=

# Slack or Discord incoming webhook for error reports (same as the web app).
ERROR_WEBHOOK_URL=
