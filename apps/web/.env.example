# ─────────────────────────────────────────────────────────────────────────────
# MBAAntisocial web app (apps/web). Copy to .env.local for `npm run dev`,
# or to .env for docker compose. Only the first block is required; every
# optional feature switches itself on when its keys are present.
# src/lib/env.ts validates this file at boot and explains what is wrong.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──
# Local: mongodb://127.0.0.1:27017/mba-antisocial?replicaSet=rs0&directConnection=true
MONGODB_URI=mongodb://127.0.0.1:27017/mba-antisocial
# 32+ characters. Generate with: npx auth secret
AUTH_SECRET=
# The public origin people open in their browser.
APP_URL=http://localhost:3000

# ── Who can sign up ──
# Optional extra allow-list on top of the campus registry, e.g. iima.ac.in,iimb.ac.in
ALLOWED_EMAIL_DOMAINS=
# Promoted to platform admin when they sign in.
PLATFORM_ADMIN_EMAILS=

# ── Realtime (apps/realtime) — live chat, notifications, multiplayer games ──
REDIS_URL=redis://127.0.0.1:6379
# Shared with apps/realtime. 32+ random characters.
REALTIME_SECRET=
INTERNAL_API_SECRET=
# Where browsers reach the realtime service (baked into the client at build time).
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000
# Origins allowed to call the API with a bearer token from a browser, e.g. the
# Expo web preview (http://localhost:8081). Leave empty in production.
API_CORS_ORIGINS=

# Protects /api/cron/*. Vercel sends it automatically; set the same value in apps/realtime.
CRON_SECRET=
# 32-byte key (base64 or hex) for stored OAuth tokens. Defaults to one derived from AUTH_SECRET.
ENCRYPTION_KEY=

# ── AI (Claude) — interviewer, GD simulator, resume roast, timetable import, quiz ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ── Email — Resend, else SMTP, else printed to the server log ──
RESEND_API_KEY=
# e.g. smtp://user:pass@smtp.example.com:587 (docker compose points this at Mailpit)
SMTP_URL=
EMAIL_FROM="MBAAntisocial <no-reply@example.com>"

# ── File storage — Cloudinary, else local disk under UPLOAD_DIR ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_DIR=.uploads

# ── Push notifications ──
# Web push: generate a pair with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
# Native app push via Expo (optional; Expo works without it at low volume).
EXPO_ACCESS_TOKEN=

# ── Single sign-on — official institute accounts only ──
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# e.g. https://login.microsoftonline.com/<tenant-id>/v2.0 (or /common/v2.0)
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=

# ── Meetings for mock sessions — Google Meet and Zoom first, then LiveKit, Jitsi ──
# OAuth client with the Calendar API enabled; redirect URI:
#   ${APP_URL}/api/integrations/google_calendar/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Zoom OAuth app; redirect URI: ${APP_URL}/api/integrations/zoom/callback
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
JITSI_BASE_URL=https://meet.jit.si
# Built-in video and hub voice rooms. `docker compose --profile voice` runs a dev server:
#   LIVEKIT_URL=ws://localhost:7880  LIVEKIT_API_KEY=devkey  LIVEKIT_API_SECRET=secret
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Discord bridge for hub channels ──
# Redirect URI: ${APP_URL}/api/integrations/discord/callback. Set the bot token in apps/realtime too.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# ── Games ──
# STUN/TURN for peer-to-peer games, JSON: [{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
GAME_ICE_SERVERS=

# ── Daily briefing (Open Edition) ──
# Comma-separated RSS/Atom feeds. Empty uses the built-in list.
NEWS_FEEDS=
