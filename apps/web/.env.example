# Copy to .env.local and fill in. `src/lib/env.ts` validates these at boot and
# fails with a readable message rather than surfacing undefined mid-request.

# ── Required ─────────────────────────────────────────────────────────────────

# MongoDB connection string. Local Docker:
#   docker run -d -p 27017:27017 --name mba-mongo mongo:7
MONGODB_URI=mongodb://127.0.0.1:27017/mba-antisocial

# Session signing secret, 32+ characters. Generate one with:
#   npx auth secret
# Never reuse the development value in production.
AUTH_SECRET=replace-me-with-at-least-thirty-two-characters

# ── Optional ─────────────────────────────────────────────────────────────────

# Database name, when it is not already in the URI.
# MONGODB_DB_NAME=mba-antisocial

# Public origin. Used for absolute URLs.
APP_URL=http://localhost:3000

# Comma-separated email domains permitted to register. Empty means open
# registration. Pin this for a campus rollout so a batch stays a batch:
#   ALLOWED_EMAIL_DOMAINS=iima.ac.in,iimb.ac.in
ALLOWED_EMAIL_DOMAINS=

# ── Integrations ─────────────────────────────────────────────────────────────
# Not validated by `src/lib/env.ts`; each feature below needs its own keys.

# Google Gemini, read implicitly by `@ai-sdk/google` for the AI interview and
# roast routes (src/app/api/ai/*).
GOOGLE_GENERATIVE_AI_API_KEY=

# Cloudinary, for uploads. CLOUDINARY_CLOUD_NAME also pins which URLs the
# server will fetch (see isOwnCloudinaryUrl in src/lib/cloudinary.ts).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Pusher, for realtime updates. The NEXT_PUBLIC_ pair is shipped to the browser.
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Resend, for the weekly digest email. Without it /api/cron/digest returns 503.
RESEND_API_KEY=

# Bearer token the Vercel cron (vercel.json) sends to /api/cron/digest.
CRON_SECRET=
